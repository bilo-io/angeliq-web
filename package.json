{
  "name": "vision-studio",
  "version": "0.0.2",
  "description": "A container for the vision platform apps",
  "main": "index.js",
  "engines": {
    "node": ">=24"
  },
  "homepage": ".",
  "build": {
    "appId": "angeliq-web",
    "files": [
      "dist/**/*",
      "node_modules/**/*",
      "index.html",
      "app.js",
      "package.json",
      "electron.js"
    ],
    "directories": {
      "buildResources": "assets"
    },
    "mac": {
      "target": "dmg",
      "icon": "src/assets/favicon.ico"
    }
  },
  "scripts": {
    "start": "npm run dev",
    "commit": "node ./scripts/commit.js",
    "branch": "node ./scripts/branch.js",
    "release": "node ./scripts/release.js",
    "serve": "NODE_ENV=development nodemon ./server/index.js withCluster & yarn serve:browser",
    "serve:workers": "NODE_ENV=development nodemon withCluster ./server/index.js",
    "serve:browser": "node server/launch.js",
    "serve:storybook": "npx http-server ./docs/storybook",
    "start:electron": "npm run dev & electron .",
    "dev": "vite",
    "dev:electron": "concurrently \"vite\" \"wait-on http://localhost:8080 && electron .\"",
    "dev:dist": "vite build --watch",
    "dev:coverage": "$(npm bin)/nyc --silent npm run start",
    "dev:storybook": "storybook dev -p 9000",
    "build": "npm run build:dist",
    "build:dist": "vite build",
    "build:electron": "CSC_IDENTITY_AUTO_DISCOVERY=false npm run build --c.extraMetadata.main=electron.js",
    "build:storybook": "npm run clean:docs && storybook build -o docs/storybook",
    "docker:build": "npx docker build -t vision-studio:dev .",
    "docker:start": "npx docker run -it -p 3000:3000 vision-studio:dev ",
    "nyc": "$(npm bin)/nyc report --reporter=text-summary",
    "test:e2e": "$(npm bin)/cypress open",
    "test:unit": "vitest run --coverage",
    "test:unit:watch": "vitest",
    "test:coverage": "NODE_ENV=test nyc --reporter=lcov --reporter=text mocha test/*.js",
    "test:ci": "$(npm bin)/start-server-and-test dev:coverage 8080 ci:cypress",
    "ci:cypress": "$(npm bin)/cypress run  --record --key fb31f4d3-6b9c-45a8-9c56-626484c4e3b5 --parallel",
    "ci:cypress:chrome": "npm run ci:cypress --browser chrome",
    "ci:test:unit": "vitest run --coverage",
    "ci:test:chrome": "$(npm bin)/start-server-and-test dev 8080 ci:cypress:chrome",
    "ci:cypress:coverage": "$(npm bin)/nyc report --reporter=text-summary",
    "test:cli": "$(npm bin)/start-server-and-test dev 8080 ci:cypress",
    "test:cli:chrome": "$(npm bin)/start-server-and-test dev 8080 ci:cypress:chrome",
    "clean": "npm run clean:dist",
    "clean:dist": "rm -rf dist",
    "clean:docs": "rm -rf demo",
    "posttest:ci": "npm run ci:cypress:coverage",
    "postci:cypress:coverage": "$(npm bin)/codecov -t $CODECOV_TOKEN -f '.nyc_output/processinfo/index.json'",
    "postbuild:electron": "bash ./scripts/electron-post-build.sh",
    "postbuild:dist": "rm -rf artifact && cp -r ./dist ./artifact",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "preview": "vite preview",
    "lint": "eslint src --ext .js,.jsx"
  },
  "author": "Bilo Lwabona",
  "license": "ISC",
  "devDependencies": {
    "@cypress/code-coverage": "^4.1.3",
    "@fortawesome/free-brands-svg-icons": "^7.3.1",
    "@storybook/addon-docs": "^10.6.7",
    "@storybook/addon-links": "^10.6.7",
    "@storybook/react-vite": "^10.6.7",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "^5.1.0",
    "autoprefixer": "^10.6.2",
    "axios": "^1.21.1",
    "babel-eslint": "^10.1.0",
    "concurrently": "^10.0.7",
    "cypress": "^16.3.0",
    "d3": "^7.9.2",
    "dom-to-image": "^2.6.0",
    "electron": "^45.3.3",
    "electron-builder": "^26.18.0",
    "eslint": "^10.15.0",
    "eslint-config-standard": "^17.1.0",
    "eslint-formatter-gitlab": "^7.2.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-promise": "^7.3.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-standard": "^5.0.0",
    "fast-average-color": "^9.6.0",
    "firebase": "^12.19.0",
    "highcharts": "^13.1.1",
    "highlight.js": "^11.12.0",
    "html2pdf.js": "^0.14.0",
    "istanbul-lib-coverage": "^3.2.2",
    "jsdom": "^31.0.1",
    "jspdf": "^4.2.1",
    "leaflet": "^1.9.4",
    "lodash": "^4.18.1",
    "loki": "^0.35.1",
    "marked": "^18.2.1",
    "moment": "^2.31.0",
    "nodemon": "^3.1.14",
    "nyc": "^18.0.0",
    "openurl": "^1.1.1",
    "pdfkit": "^0.20.2",
    "postcss": "^8.5.33",
    "pptxgenjs": "^4.0.1",
    "prop-types": "^15.8.1",
    "rc-slider": "^11.1.9",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-fontawesome": "^1.7.1",
    "react-grid-layout": "^2.3.0",
    "react-highlight-words": "^1.0.0",
    "react-leaflet": "^5.0.0",
    "react-redux": "^9.3.1",
    "react-router": "^8.5.1",
    "redux": "^5.0.1",
    "redux-thunk": "^3.1.0",
    "regenerator-runtime": "^0.14.1",
    "sass": "^1.108.2",
    "start-server-and-test": "^3.0.13",
    "storybook": "^10.6.7",
    "tailwindcss": "^3.4.19",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "wait-on": "^9.5.1"
  },
  "resolutions": {
    "file-saver": "1.3.8"
  },
  "overrides": {
    "file-saver": "1.3.8"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron-is-dev": "^3.0.1",
    "express-history-api-fallback": "^2.2.1",
    "lucide-react": "^1.73.0",
    "tailwind-merge": "^3.7.0"
  },
  "loki": {
    "configurations": {
      "chrome.laptop": {
        "target": "chrome.app",
        "width": 1366,
        "height": 768,
        "deviceScaleFactor": 1,
        "mobile": false
      }
    }
  }
}
